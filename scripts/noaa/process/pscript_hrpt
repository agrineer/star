#
# find hrpt files and process
#
# FIXME:check operations and write to a log

# check number of args
#NUMARGS=$#
#if [ ! $NUMARGS -eq 2 ]
#then
#    echo "usage: process_script dir script"
#    exit 1
#fi

# get hrpt filename
#DATAPATH=$1
#SCRIPT=$2

# hard code parameters...
INPUTPATH=/data/pi/SCRB/process
SCRIPT=/home/pi/star/scripts/noaa/process/local_script

HRPT_FILES=$INPUTPATH/*.hrpt

shopt -s nullglob      # set nullglob so if no files in directory
                       # it won't use the asterisk as part of file name

# process all hrpt files in $INPUTPATH directory
for f in $HRPT_FILES
do
    SATTIME=`/usr/bin/basename $f .hrpt`
    echo "processing $f."

    #FIXME: check for unreasonable file size

    $SCRIPT $INPUTPATH $SATTIME
done
