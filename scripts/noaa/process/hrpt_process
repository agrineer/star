# script for processing (newly arrived)
# NOAA AVHRR seaspace (terascan) raw data files.
# using CoastWatch code (magnum opus Peter Hollemans, many thanks) 

# check number of args
NUMARGS=$#
if [ ! $NUMARGS -eq 2 ]
then
    echo "usage: hrpt_process datapath sattime"
    exit 1
fi

# get path and sat/time stamp
DATAPATH=$1
SATTIME=$2

# intermediate processing dir
PRODUCTS_DIR=/data/pi/SCRB/products

# set the projection master
MASTER_PROJ=$PRODUCTS_DIR/ScrbEquiRect.hdf

# ingester software (Terrenus) home
HRPT_HOME=/usr/local/hrpt

# calibration/TLE dir
HRPTPARMS_HOME=$HRPT_HOME/resources/terrenus/orbit

# processing software (CoastWatch) home
CWF_HOME=/usr/local/cwf

# indicate region used
REGION=scrb

#############################################################################

# go to our products directory
cd $PRODUCTS_DIR

# create unique processing directory
PROCESS_DIR=$SATTIME\_Products
/bin/mkdir $PROCESS_DIR
cd $PROCESS_DIR

# get satellite name and year
SAT=`echo $SATTIME | cut -c 1-7 | sed 's/-//' `
YEAR=`echo $SATTIME | cut -c 9-12`

echo "Starting $SATTIME.log" > $SATTIME.log
echo " " >> $SATTIME.log

# produce intermediate data file 
# value calibrated and georeferenced
# but not navigated

# following works only if processing current
# acquisitions; retro processing would report 
# erronous values
# should have client program (hrptingest) report this
# or sync to aquisition date
#
echo "two line elements used: " >> $SATTIME.log
tail -2 $HRPTPARMS_HOME/$SAT.txt >> $SATTIME.log
echo " " >> $SATTIME.log
 
echo "calibration coefficients: " >> $SATTIME.log
echo " " >> $SATTIME.log

# silly sed command; TODO: find duplicate command like 10{n;p;}
sed -n '/KEEP THIS LINE/{n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p;n;p}' < $HRPTPARMS_HOME/$SAT.properties >> $SATTIME.log
echo " " >> $SATTIME.log

echo "ingesting raw data..." >> $SATTIME.log
echo " " >> $SATTIME.log

# check for .hrpt file
if [ ! -f $DATAPATH/$SATTIME.hrpt ]
then 
  echo "no file recognized: must end with .hrpt" >> $SATTIME.log
  echo "exiting.." >> $SATTIME.log
  exit 1
fi

echo "swapping bytes in raw data..." >> $SATTIME.log
echo " " >> $SATTIME.log

/bin/dd if=$DATAPATH/$SATTIME.hrpt of=swapped.hrpt conv=swab >> $SATTIME.log 2>&1

# check exit status
if [ $? -gt 0 ]
then
  echo "byte swapping failed." >> $SATTIME.log
  rm -f swapped.hrpt
    echo "exiting.." >> $SATTIME.log
    exit 1
fi

# read the byte-swapped data file 
$HRPT_HOME/bin/hrptingest      \
    --year=$YEAR               \
    --informat=raw-hrpt        \
    --origin="PlanetaryImaging.org"    \
    swapped.hrpt \
    ingest.nc >> $SATTIME.log 2>&1

# check exit status
if [ $? -gt 0 ]
then

  echo "ingest failed." >> $SATTIME.log
  echo "exiting.." >> $SATTIME.log
  rm -f swapped.hrpt
  exit 1
fi

rm -f swapped.hrpt

echo "importing ingest.nc" >> $SATTIME.log
$CWF_HOME/bin/cwimport ingest.nc ingest.hdf
rm -f ingest.nc

echo " " >> $SATTIME.log
echo "ingest done" >> $SATTIME.log
echo " " >> $SATTIME.log

# determine which channel to use for navigating
# according to day or night scene
# print out data info while were at it
# NOTE: if night or twilight use avhrr_ch4. 
#       if day then use avhrr_ch2.

SCENETIME=`$CWF_HOME/bin/cwinfo ingest.hdf | tee -a $SATTIME.log | grep "Scene time" `

echo "$SCENETIME" >> $SATTIME.log

# check if string "night" is in SCENETIME
if [[ $SCENETIME == *"night"* ]]
then
    CHANNEL=avhrr_ch4
else
    CHANNEL=avhrr_ch2
fi

echo "navigating ... " >> $SATTIME.log
echo "using channel $CHANNEL" >> $SATTIME.log

# NOTE: we want default match (process all data sets)
#       however later processing fails (cwregister) 
#       the match option below works ( all data + cwregister )
#       but don't know why
# input file is processed in situ
$CWF_HOME/bin/cwautonav         \
            --match '(avhrr.*|sat_zenith.*|rel_azimuth.*)' \
            --width 100         \
            --height 100        \
            --minboxes 3        \
            --correlation 0.92  \
            --fraction 0.05     \
            ../wdb2-cil.txt     \
            $CHANNEL            \
            ingest.hdf >> $SATTIME.log 2>&1

# check exit status
if [ $? -gt 0 ]
then
  echo "navigation failed: not enough boxes...continuing" >> $SATTIME.log
else
  echo "navigation succeeded." >> $SATTIME.log
fi
echo " " >> $SATTIME.log

# register to our region projection master
echo "projection master file: $MASTER_PROJ" >> $SATTIME.log
echo "registering data" >> $SATTIME.log
#            --match '(avhrr.*)' \
$CWF_HOME/bin/cwregister        \
            $MASTER_PROJ        \
            --verbose           \
            --method=inverse    \
            --polysize=100      \
            ingest.hdf          \
            $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1

echo " " >> $SATTIME.log
echo "register done." >> $SATTIME.log
echo " " >> $SATTIME.log

# supply our own angles 
#echo "making angles" >> $SATTIME.log

#$CWF_HOME/bin/cwangles          \
#            --verbose           \
#            --location          \
#            --sunzenith         \
#	    --float             \
#            --units=deg         \
#            $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1
#
#echo " " >> $SATTIME.log
#echo "angles done." >> $SATTIME.log
#echo " " >> $SATTIME.log

# supply graphics buffers 
echo "creating overlay graphics... " >> $SATTIME.log 
$CWF_HOME/bin/cwgraphics \
    --verbose            \
    --grid=2             \
    --coast=3            \
    --land=4             \
    --political=5        \
    $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1

echo " " >> $SATTIME.log
echo "creating overlay graphics done... " >> $SATTIME.log
echo " " >> $SATTIME.log

# create products

# we can always reprocess
rm -f ingest.hdf

# if daytime pass then render visible channels and
# add albedo and ndvi variables to data file

# check if string "day" is in SCENETIME
if [[ $SCENETIME == *"day"* ]]
then

    # render visible channels
    for (( i=1; i<=2; i+=1 )); do

	echo "rendering avhrr_ch$i" >> $SATTIME.log
	$CWF_HOME/bin/cwrender --verbose               \
	                       --enhance avhrr_ch$i    \
                               --coast red             \
                               --political blue        \
	                       --units percent         \
                               --logo ../Logo.jpg    \
                               $SATTIME\_$REGION.hdf   \
                               avhrr_ch$i.png >> $SATTIME.log 2>&1
#                               --range 1/99            \
#                               --grid red              \

	echo " " >> $SATTIME.log
	echo "avhrr_ch$i done." >> $SATTIME.log
	echo " " >> $SATTIME.log
    done

    # add albedo variable to data file
    # calculate a composite albedo using:
    # ALBEDO = 0.322*avhrr_ch1 + 0.678*avhrr_ch2
    # from Di and Rundquist (1994), He et. al. (1987)
    echo "calculating albedo..." >> $SATTIME.log
    $CWF_HOME/bin/cwmath --verbose              \
                         --longname "Albedo"    \
                         --units percent        \
                         --size float           \
             --expr "albedo = 0.322*avhrr_ch1 + 0.678*avhrr_ch2" \
	                 $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1

    $CWF_HOME/bin/cwrender --verbose              \
                           --enhance albedo       \
                           --coast black          \
                           --political red        \
                           --units percent        \
                           --palette HSL256       \
                           --logo ../Logo.jpg   \
                           $SATTIME\_$REGION.hdf  \
                           albedo.png >> $SATTIME.log 2>&1
#                          --range 1/99           \
#                          --grid white           \

    echo " " >> $SATTIME.log
    echo "albedo done." >> $SATTIME.log 
    echo " " >> $SATTIME.log

    # add ndvi variable to data file
    echo "calculating ndvi..." >> $SATTIME.log 

    $CWF_HOME/bin/cwmath --verbose \
                         --longname "Normalized Difference Vegetative Index" \
                         --size float           \
             --expr "ndvi = (avhrr_ch2-avhrr_ch1)/(avhrr_ch2+avhrr_ch1)" \
	                 $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1

    $CWF_HOME/bin/cwrender --verbose             \
                           --enhance ndvi        \
                           --coast red           \
                           --political blue      \
                           --palette NDVI        \
                           --logo ../Logo.jpg  \
                           $SATTIME\_$REGION.hdf \
                           ndvi.png >> $SATTIME.log 2>&1
#                          --range -1.0/1.0      \
#                          --grid red            \

    echo " " >> $SATTIME.log
    echo "ndvi done." >> $SATTIME.log
    echo " " >> $SATTIME.log

    # throw in a false color image for grins (recreational)
    echo "rendering false color..." >> $SATTIME.log
    $CWF_HOME/bin/cwrender --verbose                                 \
                           --composite avhrr_ch1/avhrr_ch2/avhrr_ch4 \
                           --bluefunction linear-reverse             \
                           --coast black                             \
                           --political blue                          \
                           --logo ../Logo.jpg                      \
                           $SATTIME\_$REGION.hdf                     \
                           false_color.png >> $SATTIME.log 2>&1
#                          --grid gray                               \

    echo " " >> $SATTIME.log
    echo "false color done." >> $SATTIME.log
    echo " " >> $SATTIME.log
fi


# render as thermal
echo "rendering avhrr_ch3" >> $SATTIME.log
$CWF_HOME/bin/cwrender --verbose                 \
                       --enhance avhrr_ch3       \
                       --coast black             \
                       --political black         \
                       --units celsius           \
                       --palette Red-Temperature \
                       --logo ../Logo.jpg      \
                       $SATTIME\_$REGION.hdf     \
                       avhrr_ch3.png >> $SATTIME.log 2>&1
#                      --range -50/50            \
#                      --grid white              \

echo " " >> $SATTIME.log
echo "avhrr_ch3 done." >> $SATTIME.log
echo " " >> $SATTIME.log


# render channal 3a (not used in noaa-18,19)
#echo "rendering avhrr_ch3a" >> $SATTIME.log
#$CWF_HOME/bin/cwrender --verbose               \
#                       --enhance avhrr_ch3a    \
#                       --coast red             \
#                       --political blue        \
#                       --units percent         \
#                       --logo ../Logo.jpg    \
#                       $SATTIME\_$REGION.hdf   \
#                       avhrr_ch3a.png >> $SATTIME.log 2>&1
#                      --range 1/99            \
#                      --grid red              \

#echo " " >> $SATTIME.log
#echo "avhrr_ch3a done." >> $SATTIME.log
#echo " " >> $SATTIME.log

# render thermal bands
for (( i=4; i<=5; i+=1 )); do

    echo "rendering avhrr_ch$i" >> $SATTIME.log
    $CWF_HOME/bin/cwrender --verbose                 \
                           --enhance avhrr_ch$i      \
                           --coast black             \
                           --political black         \
                           --units celsius           \
                           --palette Red-Temperature \
                           --logo ../Logo.jpg      \
                           $SATTIME\_$REGION.hdf     \
                           avhrr_ch$i.png >> $SATTIME.log 2>&1
#                          --range -50/50            \
#                          --grid white              \

    echo " " >> $SATTIME.log
    echo "avhrr_ch$i done." >> $SATTIME.log
    echo " " >> $SATTIME.log
done

# calculate land surface temperature using:
# LST = 1.035*ch4 + 3.048*(ch4-ch5) - 10.74     
# (using NOAA band designation)
# from Di and Rundquist (1994), McLain et. al. (1983)
 
# add lst variable to data file
echo "calculating lst..." >> $SATTIME.log

$CWF_HOME/bin/cwmath --verbose                             \
                     --longname "Land Surface Temperature" \
                     --units celsius                       \
                     --size float                          \
         --expr "lst = (1.035*(avhrr_ch4+273.15) + 3.048*(avhrr_ch4-avhrr_ch5) - 10.74)-273.15" \
                     $SATTIME\_$REGION.hdf >> $SATTIME.log 2>&1

$CWF_HOME/bin/cwrender --verbose                 \
                       --enhance lst             \
                       --coast black             \
                       --political black         \
                       --units celsius           \
                       --palette Red-Temperature \
                       --logo ../Logo.jpg      \
                       $SATTIME\_$REGION.hdf     \
                       lst.png >> $SATTIME.log 2>&1
#                       --range -50/50            \
#                       --grid white              \

echo " " >> $SATTIME.log
echo "lst done." >> $SATTIME.log
echo " " >> $SATTIME.log

echo "end of log. " >> $SATTIME.log

# move everything to DATAPATH
cd ..
/bin/mv $PROCESS_DIR $DATAPATH

# end 
