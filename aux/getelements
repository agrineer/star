#!/usr/bin/env bash

# retrieve grouped satellites TLEs in one file

usage() {                             
    echo "getgroup_tle: usage: getgroup_tle [-h] -g GROUP"
    exit 1
}

# check arguments
if [ $# -gt 9 ];
then
    echo "runwrf: too many arguments....exiting"
    exit 1
fi

# grab the parameters
while getopts "hg:" options; do
                                
    case "${options}" in
	g) GROUP=${OPTARG} ;;
	h) usage
	   ;;
	:)                                    
	    echo "runwrf error: ${OPTARG} requires an argument."
	    usage
	    ;;
	[?])
	    usage
	    ;;
	*)                                 
	    usage
	    ;;
    esac
done

shift $((OPTIND-1))

# directory for two line elements 
TLE_DIR=$STAR_HOME/orbits
cd $TLE_DIR

mv -f $GROUP.tle $GROUP.tle.OLD

NAME="gp.php?GROUP=${GROUP}&FORMAT=tle"

# retrieve all weather satellites TLEs
wget http://celestrak.com/NORAD/elements/$NAME
status=$?
if [ $status -gt 0 ];
then
    echo "getelements: could not get ${GROUP} file ... exiting."
    exit 2
fi

mv $NAME $GROUP.tle
status=$?
if [ $status -gt 0 ];
then
    echo "getelements: could not rename ${NAME} to ${GROUP}.tle ... exiting."
    exit 2
fi
