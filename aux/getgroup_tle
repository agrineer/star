# get satellite group TLEs, eg. weather, resource, ...
# retrieves grouped satellites TLEs in one file

usage() {                             
    echo "getgroup_tle: usage: getgroup_tle [-h] -g GROUP"
    exit 1
}

# check arguments
NUM=$#
if [[ ${NUM} != '2' && ${NUM} != '1' ]];
then
    echo "getgroup_tle: wrong number of arguments....exiting."
    usage
fi

# grab the parameters
while getopts "hg:" options; do
                                
    case "${options}" in
	g) GROUP=${OPTARG} ;;
	h) usage
	   ;;
	:)                                    
	    echo "runwrf error: ${OPTARG} requires an argument."
	    usage
	    ;;
	[?])
	    usage
	    ;;
	*)                                 
	    usage
	    ;;
    esac
done

shift $((OPTIND-1))

# directory for two line elements 
TLE_DIR=$STAR_HOME/orbits
cd $TLE_DIR

echo ${GROUP}
mv -f ${GROUP}_group.tle ${GROUP}_group.tle.OLD

NAME="gp.php?GROUP=${GROUP}&FORMAT=tle"

# retrieve all weather satellites TLEs
wget http://celestrak.com/NORAD/elements/$NAME
status=$?
if [ $status -gt 0 ];
then
    echo "getgroup_tle: could not get ${GROUP} file ... exiting."
    exit 2
fi

mv $NAME ${GROUP}_group.tle
status=$?
if [ $status -gt 0 ];
then
    echo "getgroup_tle: could not rename ${NAME} to ${GROUP}.tle ... exiting."
    exit 2
fi
